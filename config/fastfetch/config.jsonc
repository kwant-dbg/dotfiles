{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": " • "
  },
  "modules": [
    { "type": "title", "format": "trip" },
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "ker" },
    { "type": "shell", "key": "sh" },
    { "type": "wm", "key": "wm" },
    { "type": "memory", "key": "mem" },
    { "type": "uptime", "key": "up" },
    { "type": "colors", "symbol": "circle" }
  ]
}
