{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "os": "#ACB0BE",
    "closer": "p:os",
    "pink": "#F5C2E7",
    "lavender": "#B4BEFE",
    "blue": "#89B4FA",
    "teal": "#94E2D5",
    "mauve": "#CBA6F7",
    "sapphire": "#74C7EC",
    "peach": "#FAB387"
  },
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
        {
          "foreground": "p:os",
          "style": "plain",
          "template": "{{.Icon}} ",
          "type": "os"
        },
        {
          "foreground": "p:blue",
          "style": "plain",
          "template": "{{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "foreground": "p:pink",
          "options": {
            "folder_icon": "",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "p:lavender",
          "options": {
            "branch_icon": " ",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": false,
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          },
          "template": "{{ .HEAD }}{{ if .Working.Changed }} *{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }} ",
          "style": "plain",
          "type": "git"
        },
        {
          "foreground": "p:teal",
          "style": "plain",
          "template": " {{ .Full }} ",
          "type": "go"
        },
        {
          "foreground": "p:sapphire",
          "style": "plain",
          "template": " {{ .Context }} ",
          "type": "docker"
        },
        {
          "foreground": "p:mauve",
          "style": "plain",
          "template": "{{ if .Env.K8S_ACTIVE }}\uDB8C\uDCFE {{ .Context }}{{ if .Namespace }}:{{ .Namespace }}{{ end }} {{ end }}",
          "type": "kubectl"
        },
        {
          "foreground": "p:closer",
          "style": "plain",
          "template": "",
          "type": "text"
        }
      ]
    },
    {
      "alignment": "right",
      "type": "prompt",
      "segments": [
        {
          "foreground": "p:peach",
          "style": "plain",
          "properties": {
            "threshold": 500
          },
          "template": "{{ mulf .Ms 0.001 | printf \"%.1f\" }}s",
          "type": "executiontime"
        }
      ]
    },
    {
      "alignment": "left",
      "type": "prompt",
      "newline": true,
      "segments": [
        {
          "foreground": "p:pink",
          "style": "plain",
          "template": "❯ ",
          "type": "text"
        }
      ]
    }
  ],
  "final_space": true,
  "version": 4
}
